# syntax=docker/dockerfile:1.7

# =============================================================================
# BUN DISTROLESS DOCKERFILE
# bun build --compile produces a self-contained executable that still depends
# on glibc + a handful of base libs. Use distroless/cc (glibc + libssl) as the
# runtime, not scratch.
# =============================================================================

ARG BUN_VERSION=1.1.43
ARG ALPINE_VERSION=3.21

ARG VERSION=1.0.0
ARG BUILD_DATE
ARG VCS_REF

# -----------------------------------------------------------------------------
# Stage 1: Builder - compile bun → standalone (but glibc-linked) binary.
# Use the debian-slim variant so the resulting binary matches the glibc runtime.
# -----------------------------------------------------------------------------
FROM oven/bun:${BUN_VERSION}-slim AS builder

WORKDIR /app
COPY package.json bun.lock* bun.lockb* ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

COPY src ./src
RUN bun build src/main.ts --target=bun --compile --minify --outfile=app

# -----------------------------------------------------------------------------
# Stage 2: Runtime — distroless/cc (glibc + libssl + nonroot user)
# -----------------------------------------------------------------------------
FROM gcr.io/distroless/cc-debian12:nonroot

ARG VERSION
ARG BUILD_DATE
ARG VCS_REF

LABEL org.opencontainers.image.title="Bun App (Distroless)" \
      org.opencontainers.image.description="Compiled Bun binary on distroless/cc" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.base.name="gcr.io/distroless/cc-debian12:nonroot"

WORKDIR /app

COPY --from=builder --chown=nonroot:nonroot /app/app ./app

ENV PORT=3000
EXPOSE 3000
STOPSIGNAL SIGTERM
ENTRYPOINT ["./app"]
