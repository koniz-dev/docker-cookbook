{
  "name": "docker-cookbook-bun-sample",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist --minify",
    "compile": "bun build src/main.ts --target=bun --compile --outfile=app"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
