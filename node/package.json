{
  "name": "docker-cookbook-node-sample",
  "version": "1.0.0",
  "description": "Docker cookbook Node.js sample",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "path-to-regexp@0.1.12": "0.1.13"
    }
  }
}
