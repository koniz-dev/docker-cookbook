# syntax=docker/dockerfile:1.7

# =============================================================================
# PYTHON DISTROLESS DOCKERFILE
# Maximum security with distroless base + multi-arch support
# =============================================================================

ARG PYTHON_VERSION=3.13
ARG TARGETARCH

ARG VERSION=0.1.0
ARG BUILD_DATE
ARG VCS_REF

# -----------------------------------------------------------------------------
# Stage 1: Builder - Install dependencies
# -----------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-bookworm-slim AS builder

ENV UV_LINK_MODE=copy

ARG TARGETARCH

WORKDIR /build

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies with cache
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# Copy source code
COPY src/ src/

# Install project
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# -----------------------------------------------------------------------------
# Stage 2: Shared Libraries Collector
# -----------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-bookworm-slim AS lib-collector

# Re-declare so global ARG is visible inside this stage's RUN shell.
# Image already sets PYTHON_VERSION=<patch> in ENV, which would otherwise shadow us.
ARG PYTHON_VERSION
ARG TARGETARCH

# Copy shared libraries for the runtime architecture.
# `uname -m` is more robust than ARG TARGETARCH: under QEMU emulation it returns
# the *emulated* arch (x86_64 / aarch64) — which exactly matches the multiarch
# triplet directory names — and doesn't rely on ARG being injected into the RUN
# shell (which has been flaky for built-in args across buildx versions).
RUN ARCH=$(uname -m) && \
    mkdir -p /lib/multi-arch && \
    cp /lib/${ARCH}-linux-gnu/libc.so.6 /lib/multi-arch/ && \
    cp /lib/${ARCH}-linux-gnu/libm.so.6 /lib/multi-arch/ && \
    cp /lib/${ARCH}-linux-gnu/libz.so.1 /lib/multi-arch/ && \
    cp /lib/${ARCH}-linux-gnu/libgcc_s.so.1 /lib/multi-arch/ && \
    cp /usr/local/lib/libpython${PYTHON_VERSION}.so.1.0 /lib/multi-arch/

# -----------------------------------------------------------------------------
# Stage 3: Optimizer - Strip and clean
# -----------------------------------------------------------------------------
FROM builder AS optimizer

RUN apt-get update && apt-get install -y --no-install-recommends binutils && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Aggressive optimization. `strip --strip-all` exits non-zero on already-stripped
# files, so allow that one to be lenient; the rest must succeed. After cleanup,
# pre-compile .pyc files at PYTHONOPTIMIZE=2 (asserts + docstrings stripped).
RUN find .venv -type f \( -name '*.so*' -o -name '*.a' \) \
        -exec strip --strip-all {} + 2>/dev/null; \
    find .venv \( -type d -name __pycache__ -o -type f -name '*.py[co]' \) \
        -delete && \
    find .venv -type d \( -name tests -o -name test -o -name docs \) \
        -prune -exec rm -rf {} + && \
    find .venv -type f \( -name '*.pyi' -o -name '*.c' -o -name '*.h' \) \
        -delete && \
    .venv/bin/python -OO -m compileall -q -j 0 .venv src

# -----------------------------------------------------------------------------
# Stage 4: Healthcheck builder - tiny static Go binary (no shell in distroless)
# -----------------------------------------------------------------------------
FROM golang:1.26-alpine AS healthcheck-builder

WORKDIR /build
RUN go mod init healthcheck
COPY <<'EOF' /build/healthcheck.go
package main

import (
	"net/http"
	"os"
	"time"
)

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8000"
	}
	client := &http.Client{Timeout: 2 * time.Second}
	resp, err := client.Get("http://localhost:" + port + "/health")
	if err != nil {
		os.Exit(1)
	}
	defer resp.Body.Close()
	if resp.StatusCode == http.StatusOK {
		os.Exit(0)
	}
	os.Exit(1)
}
EOF

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -trimpath -o /healthcheck healthcheck.go

# -----------------------------------------------------------------------------
# Stage 5: Runtime - Distroless (maximum security)
# -----------------------------------------------------------------------------
FROM gcr.io/distroless/base-debian12:nonroot AS runtime

# Make global ARGs visible inside this stage for COPY paths + labels.
ARG PYTHON_VERSION
ARG VERSION
ARG BUILD_DATE
ARG VCS_REF

LABEL org.opencontainers.image.title="Python Service (Distroless)" \
      org.opencontainers.image.description="Maximum security Python with distroless + multi-arch" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.base.name="gcr.io/distroless/base-debian12:nonroot"

WORKDIR /app

# Copy shared libraries
COPY --from=lib-collector /lib/multi-arch/ /lib/multi-arch/

# Copy Python interpreter
COPY --from=builder /usr/local/lib/python${PYTHON_VERSION}/ /usr/local/lib/python${PYTHON_VERSION}/
COPY --from=builder /usr/local/bin/python /usr/local/bin/python3

# Copy optimized venv
COPY --from=optimizer --chown=nonroot:nonroot /build/.venv/ /app/.venv/

# Copy source code
COPY --chown=nonroot:nonroot src/ ./src/

# Environment.
# PYTHONOPTIMIZE=2 must match the optimisation level used by compileall above so
# the runtime finds the pre-compiled .pyc files (they live in __pycache__/*opt-2*).
ENV PATH="/app/.venv/bin/:$PATH" \
    PYTHONPATH="/app/src/" \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PYTHONHASHSEED=random \
    PYTHONOPTIMIZE=2 \
    HOST=0.0.0.0 \
    PORT=8000 \
    WORKERS=2 \
    LD_LIBRARY_PATH=/lib/multi-arch

# Copy static healthcheck binary
COPY --from=healthcheck-builder /healthcheck /healthcheck

# Default nonroot user in distroless (UID 65532)

EXPOSE 8000

# Healthcheck via static binary (distroless has no shell/curl).
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/healthcheck"]

STOPSIGNAL SIGTERM

ENTRYPOINT ["python"]
CMD ["-m", "src.main"]
